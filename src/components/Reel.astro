---
/**
 * A wide player for a project's clips (project.reel in copy.ts): the clips stacked in one frame,
 * and under it a row of steps, one per clip, each with a bar that fills as its clip plays. The
 * clips play one after another, round and round, while the player is on screen (scripts/reel.ts);
 * a step plays its clip; the button pauses. The poster (light or dark, after the page's scheme)
 * shows without script, and under reduced motion until a step is picked.
 */
import type { Reel } from '../data/copy';
import { inPublic } from '../lib/public';

interface Props {
  reel: Reel;
}
const { reel } = Astro.props;
const clips = reel.clips.filter((c) => inPublic(c.src));
const poster = reel.poster;
const dark = inPublic(poster.dark) ? poster.dark : null;
---
{clips.length > 0 && (
  <figure class="reel" data-reel data-reveal>
    <div class="reel__frame">
      <div class="reel__poster">
        <img class={dark ? 'slide__light' : undefined} src={poster.src} alt={poster.alt} width={poster.width} height={poster.height} loading="lazy" decoding="async" />
        {dark && <img class="slide__dark" src={dark} alt={poster.alt} width={poster.width} height={poster.height} loading="lazy" decoding="async" />}
      </div>
      {clips.map((c, i) => (
        <video class="reel__clip" data-clip={i} src={c.src} aria-label={c.alt} muted playsinline preload="none" disablepictureinpicture></video>
      ))}
      <button type="button" class="reel__toggle" data-reel-toggle aria-pressed="false" data-pause={reel.pause} data-play={reel.play}>{reel.pause}</button>
    </div>
    <div class="reel__steps" role="group" aria-label={reel.label}>
      {clips.map((c, i) => (
        <button type="button" class="reel__step" data-step-to={i} aria-pressed={i === 0 ? 'true' : 'false'}>
          <span class="reel__bar" aria-hidden="true"></span>
          <span class="reel__num" aria-hidden="true">{i + 1}</span>
          <span class="reel__label">{c.label}</span>
        </button>
      ))}
    </div>
  </figure>
)}

<script src="../scripts/reel.ts"></script>
