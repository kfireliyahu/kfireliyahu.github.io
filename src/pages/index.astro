---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Text from '../components/Text.astro';
import Paragraphs from '../components/Paragraphs.astro';
import Project from '../components/Project.astro';
import Stack from '../components/Stack.astro';
import ClaimCheck from '../components/ClaimCheck.astro';
import { inPublic } from '../lib/public';
import { site, ui, intro, emerald, usuals, howIWork, earlierWork, contact, isPlaceholder } from '../data/copy';

// The plate prints only when the poster file is in public/; the dev preview shows a marked box instead.
// The poster's slides whose files are in public/; a dark version is used only if its file is there too.
const shot = emerald.screenshot;
const slides = (shot?.slides ?? []).filter((s) => inPublic(s.src)).map((s) => ({ ...s, dark: inPublic(s.dark) ? s.dark : null }));
const shotReady = slides.length > 0;
const showPlate = shot !== null && (shotReady || import.meta.env.DEV);

// The live demo control appears only once its URL is set and the poster exists.
const demo = emerald.demo;
const demoReady = demo.src !== null && !isPlaceholder(demo.src) && shotReady;
// Until then the claim check may stand in the plate's place (emerald.poster).
const showClaim = emerald.poster === 'claim' && !demoReady;

const chapters = [
  { id: 'how-i-work', label: howIWork.heading },
  { id: 'emerald', label: emerald.name },
  { id: 'usuals', label: usuals.name },
  { id: 'earlier-work', label: earlierWork.heading, children: earlierWork.items.map((p) => ({ id: p.id, label: p.name })) },
  { id: 'contact', label: contact.heading },
];

const passages = [emerald.problem, emerald.whatItIs, emerald.yours];

// The name, split into words and letters so each letter can rise in turn. `i` runs across the whole name.
let letter = 0;
const nameWords = intro.heading.split(' ').map((w) => [...w].map((ch) => ({ ch, i: letter++ })));
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base chapters={chapters}>
  <!-- Opening: the name edge to edge, one line, and the index. Full width, above the rail. -->
  <header id="intro" slot="hero" class="open" aria-labelledby="intro-heading">
    <div class="open__bar">
      <span class="label">{site.domain}</span>
      <div class="open__bar-end">
        {intro.now && (
          <p class="open__now label">
            <span>{intro.now.label}</span> <a href={intro.now.href} class="draw">{intro.now.text}</a>
          </p>
        )}
        <button type="button" class="theme" data-theme-toggle>
          <span class="visually-hidden">{ui.theme.label}: </span>
          <span class="theme__to-dark">{ui.theme.toDark}</span>
          <span class="theme__to-light">{ui.theme.toLight}</span>
        </button>
      </div>
    </div>

    <h1 id="intro-heading" class="open__name">
      <span class="visually-hidden">{intro.heading}</span>
      <span class="open__words" aria-hidden="true">
        {nameWords.map((word, wi) => (
          <>
            {wi > 0 && ' '}
            <span class="open__word">{word.map(({ ch, i }) => <span class="open__char" style={`--i:${i}`}>{ch}</span>)}</span>
          </>
        ))}
      </span>
    </h1>

    <!-- Sized to fill the width by scripts/opening.ts; wraps at a fixed size until then, and on phones. -->
    <p class="open__line" data-reveal data-reveal-delay="4" data-fit><span><Text text={intro.line} /></span></p>

    <div class="rule open__rule" data-reveal data-reveal-delay="5"></div>

    <!-- On desktop each item flies into its place in the rail as the page scrolls (scripts/opening.ts). -->
    <nav class="open__index" aria-label="Contents" data-reveal data-reveal-delay="6">
      <ol>
        {chapters.map((c, i) => (
          <li><a href={`#${c.id}`} data-morph={c.id}><span class="open__num">{pad(i + 1)}</span><span class="draw">{c.label}</span></a></li>
        ))}
      </ol>
      <a href={`#${chapters[0].id}`} class="open__down" aria-label={intro.down}>↓</a>
    </nav>
  </header>

  <!-- 01 How I work -->
  <Section id="how-i-work" number={1} heading={howIWork.heading}>
    <div class="large"><p><Text text={howIWork.body} /></p></div>
  </Section>

  <!-- 02 Emerald, in depth -->
  <Section id="emerald" number={2} heading={emerald.name} deck={emerald.tagline} lead>
    {showClaim && <ClaimCheck note={demo.pending} />}
    {!showClaim && showPlate && shot && (
      <figure class="plate" data-reveal data-demo={demoReady ? demo.src : undefined} data-demo-title={`${emerald.name}, live demo`}>
        <div class="plate__img">
          {shotReady ? (
            <div class="slides" data-slides>
              {slides.map((s, i) => (
                <div class:list={['slide', { 'is-current': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
                  <img class={s.dark ? 'slide__light' : undefined} src={s.src} alt={s.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
                  {s.dark && <img class="slide__dark" src={s.dark} alt={s.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />}
                </div>
              ))}
            </div>
          ) : (
            <div class="plate__missing">Screenshot goes here: public{shot.slides[0]?.src}</div>
          )}
          {demoReady && (
            <div class="plate__controls">
              <button type="button" class="plate__button" data-demo-open>{demo.open}</button>
              <button type="button" class="plate__button plate__button--close" data-demo-close>{demo.close}</button>
            </div>
          )}
        </div>
        {slides.length > 1 && (
          <div class="slides__dots" role="group" aria-label={`${emerald.name}, pictures`}>
            {slides.map((_, i) => (
              <button type="button" class="slides__dot" data-slide-to={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${shot.picture} ${i + 1} of ${slides.length}`}></button>
            ))}
          </div>
        )}
        {(shot.caption || (demoReady && demo.note) || (!demoReady && demo.pending)) && (
          <figcaption>
            {shot.caption && <Text text={shot.caption} />}
            {shot.caption && ' '}
            {demoReady && demo.note && <Text text={demo.note} />}
            {!demoReady && demo.pending && <Text text={demo.pending} />}
          </figcaption>
        )}
      </figure>
    )}
    {!showClaim && !showPlate && !demoReady && demo.pending && <p class="label pending"><Text text={demo.pending} /></p>}

    {passages.map((p) => (
      <div class="passage">
        <h3><Text text={p.label} /></h3>
        <div><Paragraphs body={p.body} /></div>
      </div>
    ))}

    <Stack stack={emerald.stack} />

    <ul class="links">
      {emerald.links.site && <li><a href={emerald.links.site.href}><Text text={emerald.links.site.label} /></a></li>}
      {emerald.links.repo && <li><a href={emerald.links.repo.href}><Text text={emerald.links.repo.label} /></a></li>}
      {emerald.links.demo && <li><a href={emerald.links.demo.href}><Text text={emerald.links.demo.label} /></a></li>}
      {emerald.links.essay && <li><a href={emerald.links.essay.href}><Text text={emerald.links.essay.label} /></a></li>}
      {emerald.licence && <li class="label links__meta"><Text text={emerald.licence} /></li>}
    </ul>
  </Section>

  <!-- 03 Usuals -->
  <Section id="usuals" number={3} heading={usuals.name} deck={usuals.line}>
    <Project project={usuals} showName={false} showLine={false} />
  </Section>

  <!-- 04 Earlier work: one sub-chapter per project -->
  <Section id="earlier-work" number={4} heading={earlierWork.heading} deck={earlierWork.lead}>
    {earlierWork.items.map((item, i) => <Project project={item} number={`04.${i + 1}`} />)}
  </Section>

  <!-- 05 Contact -->
  <Section id="contact" number={5} heading={contact.heading} deck={contact.lead}>
    <a href={`mailto:${contact.email}`} class="contact__email">{contact.email}</a>
    <ul class="links">
      <li><a href={contact.github.href} rel="me">{contact.github.label}</a></li>
      {contact.linkedin && <li><a href={contact.linkedin.href} rel="me"><Text text={contact.linkedin.label} /></a></li>}
    </ul>
  </Section>

  <script src="../scripts/demo.ts"></script>
  <script src="../scripts/opening.ts"></script>
  <script src="../scripts/carousel.ts"></script>
  <script src="../scripts/claim.ts"></script>
</Base>
