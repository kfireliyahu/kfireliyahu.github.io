---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="This page does not exist.">
  <section class="open" aria-labelledby="nf-heading">
    <h1 id="nf-heading" class="open__name" data-reveal>Not found</h1>
    <p class="open__line" data-reveal data-reveal-delay="1">There is nothing at this address. <a href="/">Back to the front page.</a></p>
    <div class="rule open__rule" data-reveal data-reveal-delay="2"></div>
  </section>
</Base>
